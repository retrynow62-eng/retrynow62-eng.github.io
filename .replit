modules = ["web", "bash", "nodejs-22"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 USE_REDIS=false ILA_IP_LOCATION_DB=geo-whois-asn ILA_AUTO_UPDATE=false NODE_ENV=production node --no-node-snapshot main.js"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80
